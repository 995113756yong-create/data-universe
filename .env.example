# 复制为 .env 后修改。.env 不得提交到 git。
COLLECTORS=usgs,wiki,opensky
KAFKA_BOOTSTRAP=redpanda:9092
# Wikimedia 要求 User-Agent 带联系方式，否则可能被拒绝。必须把 <...> 换成你自己的信息。
HTTP_USER_AGENT=DataUniverse/0.1 (https://github.com/<your-github>/data-universe; <your-email>)
WIKI_SAMPLE_RATE=1.0
USGS_POLL_SECONDS=60
LOG_LEVEL=INFO

# ---- W2：OpenSky 航班 ----
# 在 https://opensky-network.org 注册后，到账号页面创建 API Client，得到 client_id / client_secret。
# 两项都留空 = 匿名访问（额度很低，最少 900 秒才能轮询一次全球数据）。
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# 注册账号默认 120 秒（最小 90）；匿名默认 900 秒（最小 900）。以 OpenSky 官方额度说明为准
OPENSKY_POLL_SECONDS=
# 网关：超过该秒数没有新位置的飞机从地球上移除。匿名访问时要大于轮询间隔
FLIGHT_WINDOW_S=1200

# ---- W3：AI 提问（OpenAI 兼容接口，留空 LLM_API_KEY 则关闭提问） ----
# 预设：deepseek | qwen（阿里云百炼 / DashScope 兼容模式）| kimi（Moonshot）| openai
# 用预设时只需填 LLM_API_KEY；模型名或地址不同就用 LLM_MODEL / LLM_BASE_URL 覆盖（以服务商文档为准）。
# 其他兼容服务（如本地 Ollama）：LLM_PROVIDER=custom，并填 LLM_BASE_URL 和 LLM_MODEL。模型需支持 function calling。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# 提问限流：每个 IP 每分钟次数、全站每天总次数（保护 API 费用）
AI_PER_MIN=5
AI_PER_DAY=300
# AI 查询用的 ClickHouse 只读账号密码（迁移 004 创建，默认 du_ai_dev；改了要同步 ALTER USER）
AI_CH_PASSWORD=du_ai_dev
